{
	"name": "@kkkiio/pi-herdr",
	"version": "0.1.0",
	"description": "Persistent background agents and live session messaging for Pi in Herdr.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"agents",
		"assets"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"herdr",
		"agent"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kkkiio/pi-herdr.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify:package": "npm run build && node scripts/verify-package.mjs",
		"test": "npm run test:bdd",
		"test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
		"test:e2e": "npm run build && HERDR_E2E=1 node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config cucumber.mjs",
		"test:regression": "npm run format:check && npm run typecheck && npm run verify:package && npm run test:bdd",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepack": "npm run build"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"dependencies": {
		"yaml": "^2.9.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.83.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@cucumber/cucumber": "^13.2.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@types/node": "^22.20.1",
		"prettier": "^3.9.6",
		"tsx": "^4.23.11",
		"typebox": "1.3.11",
		"typescript": "5.9.3"
	}
}
